{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spotify-playlist-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Needed to verify Claude's published client identity (a Client ID Metadata Document).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": { "enabled": true },

  // No IDs are needed here: Wrangler creates both namespaces on first deploy and keeps them linked.
  "kv_namespaces": [
    // Spotify refresh token, cached access token, and the IDs of playlists this connector created.
    { "binding": "KV" },
    // Claude's OAuth clients, grants and tokens (stored as hashes) for @cloudflare/workers-oauth-provider.
    { "binding": "OAUTH_KV" }
  ]

  // Secrets (set in the Cloudflare dashboard, never in this repo):
  //   SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET, CONNECTOR_KEY
}
